@@ -102,6 +102,10 @@ void Vcpop(Instruction* inst) {
   auto* rv_state = static_cast<RiscVState*>(inst->state());
   auto* rv_vector = rv_state->rv_vector();
   if (rv_vector->vstart()) {
+    // WARNING: This is a localized fix for vstart exceptions on single-scalar result instructions.
