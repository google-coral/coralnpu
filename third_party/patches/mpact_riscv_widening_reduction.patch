+TEST_F(RiscVVectorReductionInstructionsTest, WideningReductionLmul8Sew16AndSew32) {
+  SetSemanticFunction(&Vwredsumu);
+  AppendVectorRegisterOperands({kVs2, kVs1, kVmask}, {kVd});
+
+  // SEW=16 (2 bytes), LMUL=8.
+  {
+    const uint32_t vtype = (kSewSettingsByByteSize[2] << 3) | kLmulSettings[6];
+    ConfigureVectorUnit(vtype, /*vlen=*/8);
+
+    std::array<uint32_t, kVectorLengthInBytes / sizeof(uint32_t)> vs1_val = {};
+    vs1_val[0] = 0x1000'0000;
+    SetVectorRegisterValues<uint32_t>(
+        {{kVs1Name, Span<const uint32_t>(vs1_val)}});
+
+    std::array<uint16_t, kVectorLengthInBytes / sizeof(uint16_t)> vs2_reg0 = {};
+    vs2_reg0[0] = 0x1000;
+    vs2_reg0[1] = 0x2000;
+    SetVectorRegisterValues<uint16_t>(
+        {{absl::StrCat("v", kVs2), Span<const uint16_t>(vs2_reg0)}});
+
+    for (int i = 1; i < 8; ++i) {
+      std::array<uint16_t, kVectorLengthInBytes / sizeof(uint16_t)> vs2_reg_val = {};
+      auto vs2_reg_name = absl::StrCat("v", kVs2 + i);
+      SetVectorRegisterValues<uint16_t>(
+          {{vs2_reg_name, Span<const uint16_t>(vs2_reg_val)}});
+    }
+
+    std::array<uint8_t, kVectorLengthInBytes> mask_val = {};
+    mask_val[0] = 0x03;  // Elements 0 and 1 active.
+    SetVectorRegisterValues<uint8_t>(
+        {{kVmaskName, Span<const uint8_t>(mask_val)}});
+
+    ClearVectorRegisterGroup(kVd, 8);
+    instruction_->Execute();
+
+    EXPECT_FALSE(rv_vector_->vector_exception());
+    EXPECT_EQ(vreg_[kVd]->data_buffer()->Get<uint32_t>(0),
+              0x1000'0000 + 0x1000 + 0x2000);
+  }
+
+  // SEW=32 (4 bytes), LMUL=8.
+  {
+    const uint32_t vtype = (kSewSettingsByByteSize[4] << 3) | kLmulSettings[6];
+    ConfigureVectorUnit(vtype, /*vlen=*/4);
+
+    std::array<uint64_t, kVectorLengthInBytes / sizeof(uint64_t)> vs1_val = {};
+    vs1_val[0] = 0x1'0000'0000ULL;
+    SetVectorRegisterValues<uint64_t>(
+        {{kVs1Name, Span<const uint64_t>(vs1_val)}});
+
+    std::array<uint32_t, kVectorLengthInBytes / sizeof(uint32_t)> vs2_reg0 = {};
+    vs2_reg0[0] = 0x1000'0000;
+    vs2_reg0[1] = 0x2000'0000;
+    SetVectorRegisterValues<uint32_t>(
+        {{absl::StrCat("v", kVs2), Span<const uint32_t>(vs2_reg0)}});
+
+    for (int i = 1; i < 8; ++i) {
+      std::array<uint32_t, kVectorLengthInBytes / sizeof(uint32_t)> vs2_reg_val = {};
+      auto vs2_reg_name = absl::StrCat("v", kVs2 + i);
+      SetVectorRegisterValues<uint32_t>(
+          {{vs2_reg_name, Span<const uint32_t>(vs2_reg_val)}});
+    }
+
+    std::array<uint8_t, kVectorLengthInBytes> mask_val = {};
+    mask_val[0] = 0x03;
+    SetVectorRegisterValues<uint8_t>(
+        {{kVmaskName, Span<const uint8_t>(mask_val)}});
+
+    ClearVectorRegisterGroup(kVd, 8);
+    instruction_->Execute();
+
+    EXPECT_FALSE(rv_vector_->vector_exception());
+    EXPECT_EQ(vreg_[kVd]->data_buffer()->Get<uint64_t>(0),
+              0x1'0000'0000ULL + 0x1000'0000ULL + 0x2000'0000ULL);
+  }
+}
