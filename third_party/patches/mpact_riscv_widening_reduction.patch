+TEST_F(RiscVVectorReductionInstructionsTest,
+       WideningReductionUnsignedMaxLmulMasked) {
+  SetSemanticFunction(&Vwredsumu);
+  AppendVectorRegisterOperands({kVs2, kVs1, kVmask}, {kVd});
+  // sew = 8 (1 byte), lmul = 8 (m8).
+  const uint32_t vtype = (kSewSettingsByByteSize[1] << 3) | kLmulSettings[6];
+  constexpr int kVl = 12;
+  ConfigureVectorUnit(vtype, /*vlen=*/kVl);
+
+  // Scalar input vs1[0] = 0x0100.
+  std::array<uint16_t, kVectorLengthInBytes / sizeof(uint16_t)> vs1_val = {};
+  vs1_val[0] = 0x0100;
+  SetVectorRegisterValues<uint16_t>(
+      {{kVs1Name, Span<const uint16_t>(vs1_val)}});
+
+  // Vector input vs2: Active elements with mask 12'b1110 0011 0000 are indices 4, 5, 9, 10, 11.
+  std::array<uint8_t, kVectorLengthInBytes> vs2_reg0 = {};
+  vs2_reg0[4] = 10;
+  vs2_reg0[5] = 20;
+  vs2_reg0[9] = 3;
+  vs2_reg0[10] = 4;
+  vs2_reg0[11] = 5;
+  // Inactive elements (indices 0, 1, 2, 3) have non-zero values that must not be added.
+  vs2_reg0[0] = 100;
+  vs2_reg0[1] = 100;
+  vs2_reg0[2] = 100;
+  vs2_reg0[3] = 100;
+
+  SetVectorRegisterValues<uint8_t>(
+      {{absl::StrCat("v", kVs2), Span<const uint8_t>(vs2_reg0)}});
+
+  // Clear rest of vs2 registers in m8 group.
+  for (int i = 1; i < 8; ++i) {
+    std::array<uint8_t, kVectorLengthInBytes> vs2_reg_val = {};
+    auto vs2_reg_name = absl::StrCat("v", kVs2 + i);
+    SetVectorRegisterValues<uint8_t>(
+        {{vs2_reg_name, Span<const uint8_t>(vs2_reg_val)}});
+  }
+
+  std::array<uint8_t, kVectorLengthInBytes> mask_val = {};
+  mask_val[0] = 0x30;
+  mask_val[1] = 0x0e;
+  SetVectorRegisterValues<uint8_t>(
+      {{kVmaskName, Span<const uint8_t>(mask_val)}});
+
+  ClearVectorRegisterGroup(kVd, 8);
+  instruction_->Execute();
+
+  EXPECT_FALSE(rv_vector_->vector_exception());
+  // Active sum = 10 + 20 + 3 + 4 + 5 = 42. Result = 0x0100 + 42 = 0x012a.
+  EXPECT_EQ(vreg_[kVd]->data_buffer()->Get<uint16_t>(0), 0x0100 + 42);
+}
+
+TEST_F(RiscVVectorReductionInstructionsTest,
+       WideningReductionSignedMaxLmulMasked) {
+  SetSemanticFunction(&Vwredsum);
+  AppendVectorRegisterOperands({kVs2, kVs1, kVmask}, {kVd});
+  // sew = 8 (1 byte), lmul = 8 (m8).
+  const uint32_t vtype = (kSewSettingsByByteSize[1] << 3) | kLmulSettings[6];
+  constexpr int kVl = 12;
+  ConfigureVectorUnit(vtype, /*vlen=*/kVl);
+
+  // Scalar input vs1[0] = -100 (int16_t).
+  std::array<int16_t, kVectorLengthInBytes / sizeof(int16_t)> vs1_val = {};
+  vs1_val[0] = -100;
+  SetVectorRegisterValues<int16_t>({{kVs1Name, Span<const int16_t>(vs1_val)}});
+
+  // Vector input vs2: Active elements with mask 12'b1110 0011 0000 are indices 4, 5, 9, 10, 11.
+  std::array<int8_t, kVectorLengthInBytes> vs2_reg0 = {};
+  vs2_reg0[4] = -10;
+  vs2_reg0[5] = 25;
+  vs2_reg0[9] = -5;
+  vs2_reg0[10] = -20;
+  vs2_reg0[11] = 30;
+  // Inactive elements.
+  vs2_reg0[0] = 50;
+  vs2_reg0[1] = -50;
+
+  SetVectorRegisterValues<int8_t>(
+      {{absl::StrCat("v", kVs2), Span<const int8_t>(vs2_reg0)}});
+
+  for (int i = 1; i < 8; ++i) {
+    std::array<int8_t, kVectorLengthInBytes> vs2_reg_val = {};
+    auto vs2_reg_name = absl::StrCat("v", kVs2 + i);
+    SetVectorRegisterValues<int8_t>(
+        {{vs2_reg_name, Span<const int8_t>(vs2_reg_val)}});
+  }
+
+  std::array<uint8_t, kVectorLengthInBytes> mask_val = {};
+  mask_val[0] = 0x30;
+  mask_val[1] = 0x0e;
+  SetVectorRegisterValues<uint8_t>(
+      {{kVmaskName, Span<const uint8_t>(mask_val)}});
+
+  ClearVectorRegisterGroup(kVd, 8);
+  instruction_->Execute();
+
+  EXPECT_FALSE(rv_vector_->vector_exception());
+  // Active sum = (-10) + 25 + (-5) + (-20) + 30 = 20. Result = -100 + 20 = -80.
+  EXPECT_EQ(vreg_[kVd]->data_buffer()->Get<int16_t>(0), -80);
+}
+
+TEST_F(RiscVVectorReductionInstructionsTest,
+       WideningReductionAllMaskedOutPreservesScalar) {
+  SetSemanticFunction(&Vwredsumu);
+  AppendVectorRegisterOperands({kVs2, kVs1, kVmask}, {kVd});
+  // sew = 8, lmul = 8.
+  const uint32_t vtype = (kSewSettingsByByteSize[1] << 3) | kLmulSettings[6];
+  ConfigureVectorUnit(vtype, /*vlen=*/16);
+
+  std::array<uint16_t, kVectorLengthInBytes / sizeof(uint16_t)> vs1_val = {};
+  vs1_val[0] = 0xbeef;
+  SetVectorRegisterValues<uint16_t>(
+      {{kVs1Name, Span<const uint16_t>(vs1_val)}});
+
+  // Set non-zero in vs2.
+  for (int i = 0; i < 8; ++i) {
+    std::array<uint8_t, kVectorLengthInBytes> vs2_reg_val = {};
+    vs2_reg_val.fill(0xff);
+    auto vs2_reg_name = absl::StrCat("v", kVs2 + i);
+    SetVectorRegisterValues<uint8_t>(
+        {{vs2_reg_name, Span<const uint8_t>(vs2_reg_val)}});
+  }
+
+  // All elements masked out (mask = 0).
+  std::array<uint8_t, kVectorLengthInBytes> mask_val = {};
+  SetVectorRegisterValues<uint8_t>(
+      {{kVmaskName, Span<const uint8_t>(mask_val)}});
+
+  ClearVectorRegisterGroup(kVd, 8);
+  instruction_->Execute();
+
+  EXPECT_FALSE(rv_vector_->vector_exception());
+  // When all elements are masked out, scalar operand vs1[0] is still preserved.
+  EXPECT_EQ(vreg_[kVd]->data_buffer()->Get<uint16_t>(0), 0xbeef);
+}
