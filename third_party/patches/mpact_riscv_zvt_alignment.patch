+uint32_t F32Mul(uint32_t ui_a, uint32_t ui_b, uint32_t rounding_mode,
+                uint32_t* flags) {
+  const bool sign_a = SignF32UI(ui_a);
+  int16_t exp_a = ExpF32UI(ui_a);
+  uint32_t sig_a = FracF32UI(ui_a);
+  const bool sign_b = SignF32UI(ui_b);
+  int16_t exp_b = ExpF32UI(ui_b);
+  uint32_t sig_b = FracF32UI(ui_b);
+  const bool sign_z = sign_a ^ sign_b;
+
+  if (exp_a == 0xFF) {
+    if (sig_a || ((exp_b == 0xFF) && sig_b)) {
+      return PropagateNaNF32UI(ui_a, ui_b, flags);
+    }
+    if ((exp_b | sig_b) == 0) {
+      *flags |= kFpFlagInvalid;
+      return kDefaultNaNF32UI;
+    }
+    return PackToF32UI(sign_z, 0xFF, 0);
+  }
+  if (exp_b == 0xFF) {
+    if (sig_b) {
+      return PropagateNaNF32UI(ui_a, ui_b, flags);
+    }
+    if ((exp_a | sig_a) == 0) {
+      *flags |= kFpFlagInvalid;
+      return kDefaultNaNF32UI;
+    }
+    return PackToF32UI(sign_z, 0xFF, 0);
+  }
+  if (!exp_a) {
+    if (!sig_a) return PackToF32UI(sign_z, 0, 0);
+    NormSubnormalF32Sig(sig_a, &exp_a, &sig_a);
+  }
+  if (!exp_b) {
+    if (!sig_b) return PackToF32UI(sign_z, 0, 0);
+    NormSubnormalF32Sig(sig_b, &exp_b, &sig_b);
+  }
+  int16_t exp_z = exp_a + exp_b - 0x7F;
+  sig_a = (sig_a | 0x00800000u) << 7;
+  sig_b = (sig_b | 0x00800000u) << 8;
+  uint32_t sig_z = static_cast<uint32_t>(
+      ShiftRightJam64(static_cast<uint64_t>(sig_a) * sig_b, 32));
+  if (sig_z < 0x40000000u) {
+    --exp_z;
+    sig_z <<= 1;
+  }
+  return RoundPackToF32(sign_z, exp_z, sig_z, rounding_mode, flags);
+}
+
+uint32_t AddMagsF32(uint32_t ui_a, uint32_t ui_b, uint32_t rounding_mode,
+                    uint32_t* flags) {
+  const int16_t exp_a = ExpF32UI(ui_a);
+  uint32_t sig_a = FracF32UI(ui_a);
+  const int16_t exp_b = ExpF32UI(ui_b);
+  uint32_t sig_b = FracF32UI(ui_b);
+  const int16_t exp_diff = exp_a - exp_b;
+  bool sign_z;
+  int16_t exp_z;
+  uint32_t sig_z;
+  if (!exp_diff) {
+    if (!exp_a) return ui_a + sig_b;
+    if (exp_a == 0xFF) {
+      if (sig_a | sig_b) return PropagateNaNF32UI(ui_a, ui_b, flags);
+      return ui_a;
+    }
+    sign_z = SignF32UI(ui_a);
+    exp_z = exp_a;
+    sig_z = 0x01000000u + sig_a + sig_b;
+    if (!(sig_z & 1) && (exp_z < 0xFE)) {
+      return PackToF32UI(sign_z, exp_z, sig_z >> 1);
+    }
+    sig_z <<= 6;
+  } else {
+    sign_z = SignF32UI(ui_a);
+    sig_a <<= 6;
+    sig_b <<= 6;
+    if (exp_diff < 0) {
+      if (exp_b == 0xFF) {
+        if (sig_b) return PropagateNaNF32UI(ui_a, ui_b, flags);
+        return PackToF32UI(sign_z, 0xFF, 0);
+      }
+      exp_z = exp_b;
+      sig_a += exp_a ? 0x20000000u : sig_a;
+      sig_a = ShiftRightJam32(sig_a, static_cast<uint16_t>(-exp_diff));
+    } else {
+      if (exp_a == 0xFF) {
+        if (sig_a) return PropagateNaNF32UI(ui_a, ui_b, flags);
+        return ui_a;
+      }
+      exp_z = exp_a;
+      sig_b += exp_b ? 0x20000000u : sig_b;
+      sig_b = ShiftRightJam32(sig_b, static_cast<uint16_t>(exp_diff));
+    }
+    sig_z = 0x20000000u + sig_a + sig_b;
+    if (sig_z < 0x40000000u) {
+      --exp_z;
+      sig_z <<= 1;
+    }
+  }
+  return RoundPackToF32(sign_z, exp_z, sig_z, rounding_mode, flags);
+}
+
+uint32_t SubMagsF32(uint32_t ui_a, uint32_t ui_b, uint32_t rounding_mode,
+                    uint32_t* flags) {
+  int16_t exp_a = ExpF32UI(ui_a);
+  uint32_t sig_a = FracF32UI(ui_a);
+  const int16_t exp_b = ExpF32UI(ui_b);
+  uint32_t sig_b = FracF32UI(ui_b);
+  int16_t exp_diff = exp_a - exp_b;
+  if (!exp_diff) {
+    if (exp_a == 0xFF) {
+      if (sig_a | sig_b) return PropagateNaNF32UI(ui_a, ui_b, flags);
+      *flags |= kFpFlagInvalid;
+      return kDefaultNaNF32UI;
+    }
+    int32_t sig_diff =
+        static_cast<int32_t>(sig_a) - static_cast<int32_t>(sig_b);
+    if (!sig_diff) {
+      return PackToF32UI(rounding_mode == kFpRoundDown, 0, 0);
+    }
+    if (exp_a) --exp_a;
+    bool sign_z = SignF32UI(ui_a);
+    if (sig_diff < 0) {
+      sign_z = !sign_z;
+      sig_diff = -sig_diff;
+    }
+    int shift_dist = CountLeadingZeros32(static_cast<uint32_t>(sig_diff)) - 8;
+    int16_t exp_z = exp_a - shift_dist;
+    if (exp_z < 0) {
+      shift_dist = exp_a;
+      exp_z = 0;
+    }
+    return PackToF32UI(sign_z, exp_z,
+                       static_cast<uint32_t>(sig_diff) << shift_dist);
+  } else {
+    bool sign_z = SignF32UI(ui_a);
+    sig_a <<= 7;
+    sig_b <<= 7;
+    int16_t exp_z;
+    uint32_t sig_x, sig_y;
+    if (exp_diff < 0) {
+      sign_z = !sign_z;
+      if (exp_b == 0xFF) {
+        if (sig_b) return PropagateNaNF32UI(ui_a, ui_b, flags);
+        return PackToF32UI(sign_z, 0xFF, 0);
+      }
+      exp_z = exp_b - 1;
+      sig_x = sig_b | 0x40000000u;
+      sig_y = sig_a + (exp_a ? 0x40000000u : sig_a);
+      exp_diff = -exp_diff;
+    } else {
+      if (exp_a == 0xFF) {
+        if (sig_a) return PropagateNaNF32UI(ui_a, ui_b, flags);
+        return ui_a;
+      }
+      exp_z = exp_a - 1;
+      sig_x = sig_a | 0x40000000u;
+      sig_y = sig_b + (exp_b ? 0x40000000u : sig_b);
+    }
+    return NormRoundPackToF32(
+        sign_z, exp_z,
+        sig_x - ShiftRightJam32(sig_y, static_cast<uint16_t>(exp_diff)),
+        rounding_mode, flags);
+  }
+}
+
+uint32_t F32Add(uint32_t ui_a, uint32_t ui_b, uint32_t rounding_mode,
+                uint32_t* flags) {
+  if (SignF32UI(ui_a ^ ui_b)) {
+    return SubMagsF32(ui_a, ui_b, rounding_mode, flags);
+  }
+  return AddMagsF32(ui_a, ui_b, rounding_mode, flags);
+}
+
+uint32_t F32AddOdd(uint32_t ui_a, uint32_t ui_b, uint32_t* flags) {
+  uint32_t local_flags = 0;
+  uint32_t res = F32Add(ui_a, ui_b, kFpRoundOdd, &local_flags);
+  if (local_flags & kFpFlagOverflow) {
+    res += 1;  // FLT_MAX -> INF (RVBNA Rounding to Odd)
+  }
+  *flags |= local_flags & (kFpFlagOverflow | kFpFlagInvalid);
+  return res;
+}
+
+template <typename T>
+int IntLog2(T n) {
+  int res = 0;
+  while (n >>= 1) {
+    res++;
+  }
+  return res;
+}
+
+template <typename T>
+T ShiftRightJamGeneric(T n, int amt) {
+  const int width = 8 * sizeof(T);
+  const T shifted = amt >= width ? 0 : (n >> amt);
+  const T jam_mask = amt >= width ? T(-1) : ((T(1) << amt) - 1);
+  const bool jam = (n & jam_mask) != 0;
+  return shifted | static_cast<T>(jam);
+}
