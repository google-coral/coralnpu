+uint32_t NormRoundPackToF32(bool sign, int16_t exp, uint32_t sig,
+                            uint32_t rounding_mode, uint32_t* flags) {
+  const int shift_dist = CountLeadingZeros32(sig) - 1;
+  exp -= shift_dist;
+  if ((7 <= shift_dist) &&
+      (static_cast<uint32_t>(static_cast<uint16_t>(exp)) < 0xFDu)) {
+    return PackToF32UI(sign, sig ? exp : 0, sig << (shift_dist - 7));
+  }
+  return RoundPackToF32(sign, exp, sig << shift_dist, rounding_mode, flags);
+}
