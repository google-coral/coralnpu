+      return PackToF32UI(sign, 0xFF, 0) - (round_increment == 0 ? 1u : 0u);
+    }
+  }
+  sig = (sig + round_increment) >> 7;
+  if (round_bits) {
+    *flags |= kFpFlagInexact;
+    if (rounding_mode == kFpRoundOdd) {
+      sig |= 1;
+      return PackToF32UI(sign, exp, sig);
+    }
+  }
+  sig &= ~static_cast<uint32_t>(!(round_bits ^ 0x40) & round_near_even);
+  if (!sig) exp = 0;
+  return PackToF32UI(sign, exp, sig);
