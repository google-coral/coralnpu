+// RVBNA bulk-normalized 2-way BF16 dot product (without accumulation), rounded
+// to odd into FP32 per Zvt v0.4 §12.1.1.8.
+uint32_t BulkNormDotBf16(const uint16_t a[2], const uint16_t b[2],
+                         uint32_t* flags) {
+  constexpr int kNumProd = 2;
+  constexpr int kGuardBits = 1;
+  constexpr int kF32ExpBits = 8;
+  constexpr int kF32ExpBias = 127;
+  constexpr int kF32MantBits = 23;
+  constexpr int kF32ExpMask = 0xFF;
+  constexpr uint32_t kF32MantMask = 0x007FFFFFu;
+  constexpr int kBf16Bias = 127;
+  constexpr int kBf16MantBits = 7;
+
+  auto bf16_sign = [](uint16_t x) -> bool { return (x >> 15) != 0; };
+  auto bf16_exp = [](uint16_t x) -> int { return (x >> 7) & 0xFF; };
+  auto bf16_mant = [](uint16_t x) -> uint8_t { return x & 0x7F; };
+  auto bf16_sub_or_zero = [&](uint16_t x) -> bool { return bf16_exp(x) == 0; };
+  auto bf16_exp_sub_fixed = [&](uint16_t x) -> int {
+    return bf16_exp(x) + (bf16_sub_or_zero(x) ? 1 : 0);
+  };
+  auto bf16_sig = [&](uint16_t x) -> uint16_t {
+    return bf16_mant(x) ^ (static_cast<uint16_t>(!bf16_sub_or_zero(x)) << 7);
+  };
+  auto bf16_inf = [&](uint16_t x) -> bool {
+    return bf16_exp(x) == 0xFF && bf16_mant(x) == 0;
+  };
+  auto bf16_nan = [&](uint16_t x) -> bool {
+    return bf16_exp(x) == 0xFF && bf16_mant(x) != 0;
+  };
+  auto bf16_sig_nan = [&](uint16_t x) -> bool {
+    return bf16_nan(x) && ((bf16_mant(x) >> 6) == 0);
+  };
+  auto bf16_is_zero = [&](uint16_t x) -> bool {
+    return bf16_exp(x) == 0 && bf16_mant(x) == 0;
+  };
+
+  int approx_prod_exp[kNumProd];
+  uint16_t prod_sigs[kNumProd];
+  bool any_pos_inf = false;
+  bool any_neg_inf = false;
+  bool any_nan = false;
+  bool any_invalid_nan = false;
+  bool any_sig_nan = false;
+
+  for (int i = 0; i < kNumProd; i++) {
+    prod_sigs[i] = bf16_sig(a[i]) * bf16_sig(b[i]);
+    const bool a_zero = bf16_is_zero(a[i]);
+    const bool b_zero = bf16_is_zero(b[i]);
+    approx_prod_exp[i] =
+        (a_zero || b_zero)
+            ? (kF32ExpBias - (kBf16Bias + kBf16Bias))
+            : (bf16_exp_sub_fixed(a[i]) + bf16_exp_sub_fixed(b[i]) +
+               (kF32ExpBias - (kBf16Bias + kBf16Bias)));
+
+    const bool either_inf = bf16_inf(a[i]) || bf16_inf(b[i]);
+    const bool either_nan = bf16_nan(a[i]) || bf16_nan(b[i]);
+    const bool either_zero = a_zero || b_zero;
+    any_pos_inf |= either_inf && !either_nan && !either_zero &&
+                   (bf16_sign(a[i]) == bf16_sign(b[i]));
+    any_neg_inf |= either_inf && !either_nan && !either_zero &&
+                   (bf16_sign(a[i]) != bf16_sign(b[i]));
+    any_invalid_nan |= (bf16_inf(a[i]) && b_zero) || (bf16_inf(b[i]) && a_zero);
+    any_nan |= any_invalid_nan || either_nan;
+    any_sig_nan |= bf16_sig_nan(a[i]) || bf16_sig_nan(b[i]);
+  }
+
+  const int max_approx_prod_exp =
+      std::max(approx_prod_exp[0], approx_prod_exp[1]);
+  int64_t acc = 0;
+  for (int i = 0; i < kNumProd; i++) {
+    const bool prod_sign = bf16_sign(a[i]) ^ bf16_sign(b[i]);
+    uint64_t prod_sig = static_cast<uint64_t>(prod_sigs[i])
+                        << (kF32MantBits - kBf16MantBits - kBf16MantBits +
+                            kGuardBits);
+    const int shift_amt = max_approx_prod_exp - approx_prod_exp[i];
+    const uint64_t shifted_sig = ShiftRightJamGeneric(prod_sig, shift_amt);
+    acc += prod_sign ? -static_cast<int64_t>(shifted_sig)
+                     : static_cast<int64_t>(shifted_sig);
+  }
+
+  bool sign = acc < 0;
+  const uint64_t mag =
+      acc < 0 ? static_cast<uint64_t>(-acc) : static_cast<uint64_t>(acc);
+  const int norm_dist = IntLog2(mag);
+  int exp = max_approx_prod_exp - kF32MantBits - kGuardBits + norm_dist;
+  int sig_bits = (exp <= 0) ? (kF32MantBits - (1 - exp)) : kF32MantBits;
+  sig_bits = std::max(sig_bits, 0);
+  uint32_t rounded_sig = static_cast<uint32_t>(
+      ShiftRightJamGeneric(mag << sig_bits, norm_dist));
+
+  const bool any_inf = any_pos_inf || any_neg_inf;
+  const bool overflow = (exp >= kF32ExpMask && mag != 0) || any_inf;
+  const bool op_sign_inf = any_pos_inf && any_neg_inf;
+  const bool nan_out = any_nan || op_sign_inf;
+  const bool overflow_flag =
+      (exp >= kF32ExpMask && mag != 0) && !any_inf && !nan_out;
+
+  if (nan_out) {
+    sign = false;
+    exp = kF32ExpMask;
+    rounded_sig = uint32_t{1} << (kF32MantBits - 1);
+  } else if (overflow) {
+    exp = kF32ExpMask;
+    rounded_sig = 0;
+    if (any_inf) sign = any_neg_inf;
+  } else if (mag == 0 || exp <= 0) {
+    exp = 0;
+  }
+
+  if (any_sig_nan || any_invalid_nan || op_sign_inf) {
+    *flags |= kFpFlagInvalid;
+  }
+  if (overflow_flag) {
+    *flags |= kFpFlagOverflow;
+  }
+
+  return (rounded_sig & kF32MantMask) |
+         (static_cast<uint32_t>(exp) << kF32MantBits) |
+         (static_cast<uint32_t>(sign) << (kF32ExpBits + kF32MantBits));
+}
