@@ -32,6 +37,348 @@ namespace riscv {
 
 using generic::GetInstructionSource;
 
+namespace {
+
+int ExtractVRegNumber(absl::string_view name) {
+  if (name.size() < 2 || name[0] != 'v') return -1;
+  int val = 0;
+  for (size_t i = 1; i < name.size(); ++i) {
+    char c = name[i];
+    if (c < '0' || c > '9') break;
+    val = val * 10 + (c - '0');
+  }
+  return (val >= 0 && val < 32) ? val : -1;
+}
+
+int GetLoadDestRegNumber(const Instruction* inst) {
+  if (inst == nullptr || inst->child() == nullptr ||
+      inst->child()->DestinationsSize() < 1) {
+    return -1;
+  }
+  auto* dest_op = static_cast<RV32VectorDestinationOperand*>(
+      inst->child()->Destination(0));
+  if (dest_op == nullptr || dest_op->size() < 1) return -1;
+  std::any reg_any = dest_op->GetObject(0);
+  if (auto* reg_ptr = std::any_cast<generic::RegisterBase*>(&reg_any);
+      reg_ptr != nullptr && *reg_ptr != nullptr) {
+    int reg_num = ExtractVRegNumber((*reg_ptr)->name());
+    if (reg_num >= 0) return reg_num;
+  }
+  return ExtractVRegNumber(dest_op->AsString());
+}
+
+int GetVectorSourceRegNumber(const Instruction* inst, int source_index) {
+  if (inst == nullptr || inst->SourcesSize() <= source_index) return -1;
+  auto* src_op =
+      static_cast<RV32VectorSourceOperand*>(inst->Source(source_index));
+  if (src_op == nullptr || src_op->size() < 1) return -1;
+  auto* reg = src_op->GetRegister(0);
+  if (reg != nullptr) {
+    int reg_num = ExtractVRegNumber(reg->name());
+    if (reg_num >= 0) return reg_num;
+  }
+  return ExtractVRegNumber(src_op->AsString());
+}
+
+bool IsMaskedOp(const generic::SourceOperandInterface* mask_op) {
+  if (mask_op == nullptr) return false;
+  std::string name = mask_op->AsString();
+  return !name.empty() && name != "__vector_true__";
+}
+
+bool CheckVectorEnabled(RiscVState* state) {
+  if (state == nullptr) return false;
+  if (state->mstatus() != nullptr &&
+      state->mstatus()->vs() == RiscVMStatus::kStatusOff) {
+    return false;
+  }
+  return true;
+}
+
+bool CheckVectorReady(RiscVState* state, RiscVVectorState* rv_vector) {
+  if (!CheckVectorEnabled(state) || rv_vector == nullptr) return false;
+  return !rv_vector->is_vill();
+}
+
+bool ComputeEmul8(RiscVVectorState* rv_vector, int width_bytes, int* emul8_out,
+                  int* reg_mul_out) {
+  if (width_bytes != 1 && width_bytes != 2 && width_bytes != 4 &&
+      width_bytes != 8) {
+    return false;
+  }
+  if (width_bytes * 8 > rv_vector->max_elen()) return false;
+  int sew = rv_vector->selected_element_width();
+  int lmul8 = rv_vector->vector_length_multiplier();
+  if ((sew != 1 && sew != 2 && sew != 4 && sew != 8) || lmul8 <= 0) {
+    return false;
+  }
+  if ((width_bytes * lmul8) % sew != 0) return false;
+  int emul8 = (width_bytes * lmul8) / sew;
+  // Per RVV 1.0 Section 3.4.2, the minimum supported fractional EMUL is
+  // SEW_min / ELEN = 1 / (max_elen / 8), so emul8 * max_elen >= 64, and the
+  // maximum supported EMUL is 8 (emul8 <= 64).
+  if (emul8 < 1 || emul8 > 64 || emul8 * rv_vector->max_elen() < 64) {
+    return false;
+  }
+  *emul8_out = emul8;
+  *reg_mul_out = std::max(1, emul8 / 8);
+  return true;
+}
+
+bool IsAlignedGroupInBounds(int reg, int reg_mul, int num_fields) {
+  if (reg < 0 || reg >= 32) return false;
+  if (reg_mul < 1 || reg_mul > 8) return false;
+  if (num_fields < 1 || num_fields > 8) return false;
+  if ((reg % reg_mul) != 0) return false;
+  if (reg + num_fields * reg_mul > 32) return false;
+  return true;
+}
+
+bool ValidateIndexedLoadOverlap(int vd_reg, int data_reg_mul, int vs2_reg,
+                                int index_reg_mul, int index_emul8,
+                                int sew_bytes, int index_width_bytes,
+                                int num_fields) {
+  int vd_end = vd_reg + num_fields * data_reg_mul;
+  int vs2_end = vs2_reg + index_reg_mul;
+  bool overlaps = (vd_reg < vs2_end) && (vs2_reg < vd_end);
+  if (!overlaps) return true;
+  // Per RVV 1.0 Section 7.8.3, destination vector register groups cannot
+  // overlap the source index vector register group for segment indexed loads.
+  if (num_fields > 1) return false;
+  // Per RVV 1.0 Section 7.3 & Section 5.2:
+  // - Narrowing (EEW_data < EEW_index): overlap is legal only when vd is
+  //   aligned to index_reg_mul (lowest-numbered part of vs2 group).
+  if (index_width_bytes > sew_bytes) {
+    return (vd_reg % index_reg_mul) == 0;
+  }
+  // - Widening (EEW_data > EEW_index): overlap is legal only when EMUL_index >= 1
+  //   (index_emul8 >= 8) and vs2 is the highest-numbered part of the vd
+  //   register group.
+  if (index_width_bytes < sew_bytes) {
+    return (index_emul8 >= 8) &&
+           (vs2_reg == (vd_reg + data_reg_mul - index_reg_mul));
+  }
+  return true;
+}
