+bool ValidateVlStrided(int element_width, const Instruction* inst) {
+  auto* state = static_cast<RiscVState*>(inst->state());
+  auto* rv_vector = state->rv_vector();
+  if (!CheckVectorReady(state, rv_vector)) return false;
+  int emul8 = 0, reg_mul = 0;
+  if (!ComputeEmul8(rv_vector, element_width, &emul8, &reg_mul)) return false;
+  int vd_reg = GetLoadDestRegNumber(inst);
+  if (!IsAlignedGroupInBounds(vd_reg, reg_mul, /*num_fields=*/1)) return false;
+  if (IsMaskedOp(inst->Source(2)) && vd_reg == 0) return false;
+  return true;
+}
+
+bool ValidateVlm(const Instruction* inst) {
+  auto* state = static_cast<RiscVState*>(inst->state());
+  auto* rv_vector = state->rv_vector();
+  if (!CheckVectorReady(state, rv_vector)) return false;
+  int vd_reg = GetLoadDestRegNumber(inst);
+  return IsAlignedGroupInBounds(vd_reg, /*reg_mul=*/1, /*num_fields=*/1);
+}
+
+bool ValidateVlIndexed(int index_width, const Instruction* inst) {
+  auto* state = static_cast<RiscVState*>(inst->state());
+  auto* rv_vector = state->rv_vector();
+  if (!CheckVectorReady(state, rv_vector)) return false;
+  int sew = rv_vector->selected_element_width();
+  int data_emul8 = 0, data_reg_mul = 0;
+  if (!ComputeEmul8(rv_vector, sew, &data_emul8, &data_reg_mul)) return false;
+  int index_emul8 = 0, index_reg_mul = 0;
+  if (!ComputeEmul8(rv_vector, index_width, &index_emul8, &index_reg_mul)) {
+    return false;
+  }
+  int vd_reg = GetLoadDestRegNumber(inst);
+  int vs2_reg = GetVectorSourceRegNumber(inst, 1);
+  if (!IsAlignedGroupInBounds(vd_reg, data_reg_mul, /*num_fields=*/1)) {
+    return false;
+  }
+  if (!IsAlignedGroupInBounds(vs2_reg, index_reg_mul, /*num_fields=*/1)) {
+    return false;
+  }
+  if (IsMaskedOp(inst->Source(2)) && vd_reg == 0) return false;
+  return ValidateIndexedLoadOverlap(vd_reg, data_reg_mul, vs2_reg,
+                                    index_reg_mul, index_emul8, sew,
+                                    index_width, /*num_fields=*/1);
+}
+
+bool ValidateVlRegister(int num_regs, int element_width_bytes,
+                        const Instruction* inst) {
+  auto* state = static_cast<RiscVState*>(inst->state());
+  auto* rv_vector = state->rv_vector();
+  if (!CheckVectorEnabled(state) || rv_vector == nullptr) return false;
+  if (num_regs != 1 && num_regs != 2 && num_regs != 4 && num_regs != 8) {
+    return false;
+  }
+  if (element_width_bytes != 1 && element_width_bytes != 2 &&
+      element_width_bytes != 4 && element_width_bytes != 8) {
+    return false;
+  }
+  if (element_width_bytes * 8 > rv_vector->max_elen()) return false;
+  int vd_reg = GetLoadDestRegNumber(inst);
+  return IsAlignedGroupInBounds(vd_reg, num_regs, /*num_fields=*/1);
+}
+
+bool ValidateVlSegment(int element_width, const Instruction* inst) {
+  auto* state = static_cast<RiscVState*>(inst->state());
+  auto* rv_vector = state->rv_vector();
+  if (!CheckVectorReady(state, rv_vector)) return false;
+  int num_fields = GetInstructionSource<int32_t>(inst, 2) + 1;
+  int emul8 = 0, reg_mul = 0;
+  if (!ComputeEmul8(rv_vector, element_width, &emul8, &reg_mul)) return false;
