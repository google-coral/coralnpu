+TEST_F(RV32VInstructionsTest, ValidateVlStrided_RejectsUnalignedVd) {
+  // LMUL=2 (kLmulSettings[4]), SEW=32 -> EMUL=2, requires even vd.
+  uint32_t vtype =
+      (kSewSettingsByByteSize[sizeof(uint32_t)] << 3) | kLmulSettings[4];
+  ConfigureVectorUnit(vtype, /*avl=*/4);
+
+  AppendRegisterOperands({kRs1Name, kRs2Name}, {});
+  AppendVectorRegisterOperands({kVmask}, {});
+  SetSemanticFunction(absl::bind_front(&VlStrided, sizeof(uint32_t)));
+  SetChildInstruction();
+  SetChildSemanticFunction(&VlChild);
+  // Odd destination register v3 is illegal for EMUL=2.
+  AppendVectorRegisterOperands(child_instruction_, {}, {3});
+
+  instruction_->Execute(nullptr);
+  EXPECT_TRUE(rv_vector_->vector_exception());
+}
+
+TEST_F(RV32VInstructionsTest, ValidateVlIndexed_OverlapRules) {
+  // SEW=32, LMUL=2 (data_reg_mul=2), index_width=16 (index_reg_mul=1).
+  // Widening load: legal only when vs2 == vd + data_reg_mul - index_reg_mul = vd + 1.
+  uint32_t vtype =
+      (kSewSettingsByByteSize[sizeof(uint32_t)] << 3) | kLmulSettings[4];
+  ConfigureVectorUnit(vtype, /*avl=*/4);
+
+  // Case 1: vd=v8, vs2=v8 (lowest part of vd group) -> Illegal for widening.
+  AppendRegisterOperands({kRs1Name}, {});
+  AppendVectorRegisterOperands({8, kVmask}, {});
+  SetSemanticFunction(absl::bind_front(&VlIndexed, sizeof(uint16_t)));
+  SetChildInstruction();
+  SetChildSemanticFunction(&VlChild);
+  AppendVectorRegisterOperands(child_instruction_, {}, {8});
+
+  instruction_->Execute(nullptr);
+  EXPECT_TRUE(rv_vector_->vector_exception());
+}
+
+TEST_F(RV32VInstructionsTest,
+       ValidateVlIndexed_RejectsWideningFractionalIndexOverlap) {
+  // SEW=16, LMUL=1/2 (kLmulSettings[2]) -> data_emul=1/2, index_width=8 ->
+  // index_emul=1/4 (< 1). Any overlap between vd and vs2 is illegal.
+  uint32_t vtype =
+      (kSewSettingsByByteSize[sizeof(uint16_t)] << 3) | kLmulSettings[2];
+  ConfigureVectorUnit(vtype, /*avl=*/4);
+
+  AppendRegisterOperands({kRs1Name}, {});
+  AppendVectorRegisterOperands({4, kVmask}, {});
+  SetSemanticFunction(absl::bind_front(&VlIndexed, sizeof(uint8_t)));
+  SetChildInstruction();
+  SetChildSemanticFunction(&VlChild);
+  AppendVectorRegisterOperands(child_instruction_, {}, {4});
+
+  instruction_->Execute(nullptr);
+  EXPECT_TRUE(rv_vector_->vector_exception());
+}
+
+TEST_F(RV32VInstructionsTest, VlSegment_PartialSecondRegister_WritesBack) {
+  // SEW=32, LMUL=2 -> 16 elements per 512-bit register.
+  // Use avl=20 so register 0 has 16 segments and register 1 has 4 segments.
+  uint32_t vtype =
+      (kSewSettingsByByteSize[sizeof(uint32_t)] << 3) | kLmulSettings[4];
+  ConfigureVectorUnit(vtype, /*avl=*/20);
+  ASSERT_EQ(rv_vector_->vector_length(), 20);
+
+  AppendRegisterOperands({kRs1Name}, {});
+  AppendVectorRegisterOperands({kVmask}, {});
+  AppendRegisterOperands({kRs3Name}, {});
+  uint8_t all_ones_mask[kVectorLengthInBytes];
+  std::memset(all_ones_mask, 0xff, sizeof(all_ones_mask));
+  SetVectorRegisterValues<uint8_t>(
+      {{kVmaskName, Span<const uint8_t>(all_ones_mask)}});
+  SetSemanticFunction(absl::bind_front(&VlSegment, sizeof(uint32_t)));
+  SetChildInstruction();
+  SetChildSemanticFunction(absl::bind_front(&VlSegmentChild, sizeof(uint32_t)));
+  AppendRegisterOperands(child_instruction_, {kRs3Name}, {});
+  AppendVectorRegisterOperands(child_instruction_, {}, {kVd});
+
+  SetRegisterValues<uint32_t>({{kRs1Name, kDataLoadAddress}});
+  SetRegisterValues<int32_t>({{kRs3Name, 1}});  // nf=1 -> 2 fields
+
+  vreg_[kVd + 1]->data_buffer()->Set<uint32_t>(0, 0);
+  vreg_[kVd + 3]->data_buffer()->Set<uint32_t>(0, 0);
+
+  instruction_->Execute(nullptr);
+  EXPECT_FALSE(rv_vector_->vector_exception());
+
+  // Segment 16 (first element of second register in each field's group) must be written.
+  uint32_t expected_f0_s16 =
+      ComputeValue<uint32_t>(4096 + 16 * 2 * sizeof(uint32_t));
+  uint32_t expected_f1_s16 =
+      ComputeValue<uint32_t>(4096 + 16 * 2 * sizeof(uint32_t) + sizeof(uint32_t));
+  EXPECT_EQ(vreg_[kVd + 1]->data_buffer()->Get<uint32_t>(0), expected_f0_s16);
+  EXPECT_EQ(vreg_[kVd + 3]->data_buffer()->Get<uint32_t>(0), expected_f1_s16);
+}
