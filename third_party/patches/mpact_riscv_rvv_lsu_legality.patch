+TEST(RiscV32GVBinDecoderTest, VectorLoadStoreLegality) {
+  // Masked loads with vd == v0 are reserved.
+  EXPECT_EQ(DecodeRiscV32GV(kVle8), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVle16), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVle32), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVle64), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVle8ff), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVlse8), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVluxei8), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVloxei8), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetNf(SetVm(kVlsegNFe8, 0), 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetNf(SetVm(kVle8ff, 0), 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetNf(SetVm(kVlssegNFe8, 0), 1)),
+            OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetNf(SetVm(kVluxsegNFei8, 0), 1)),
+            OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetNf(SetVm(kVloxsegNFei8, 0), 1)),
+            OpcodeEnum::kNone);
+
+  // vlm.v and vsm.v with vm == 0 are reserved.
+  EXPECT_EQ(DecodeRiscV32GV(kVlm), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVsm), OpcodeEnum::kNone);
+
+  // Whole-register load/store with unaligned register groups or mew == 1.
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVl2re8, 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVl4re8, 2)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVl8re8, 4)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVs2re8, 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVs4re8, 2)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(kVs8re8, 4)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVl1re8 | (1u << 28)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(kVs1re8 | (1u << 28)), OpcodeEnum::kNone);
+
+  // Whole-register moves require vm == 1 and aligned vd/vs2.
+  EXPECT_EQ(DecodeRiscV32GV(kVmv1rVi), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(SetVm(kVmv2rVi, 1), 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetVs2(SetVm(kVmv2rVi, 1), 1)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(SetVm(kVmv4rVi, 1), 2)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetVs2(SetVm(kVmv4rVi, 1), 2)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetRd(SetVm(kVmv8rVi, 1), 4)), OpcodeEnum::kNone);
+  EXPECT_EQ(DecodeRiscV32GV(SetVs2(SetVm(kVmv8rVi, 1), 4)), OpcodeEnum::kNone);
+}
