From 45a78d36efe1c77d7d4e425010dcf122f72866f0 Mon Sep 17 00:00:00 2001
From: Michael Hoang <hoangm@google.com>
Date: Thu, 24 Sep 2026 20:34:33 +0000
Subject: [PATCH 7/8] Rename yield macro to avoid conflict with boost and std

---
 riscv/decode_macros.h | 2 +-
 riscv/insns/wfi.h     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/riscv/decode_macros.h b/riscv/decode_macros.h
index 262eaec..400ec7d 100644
--- a/riscv/decode_macros.h
+++ b/riscv/decode_macros.h
@@ -244,7 +244,7 @@ static inline bool is_aligned(const unsigned val, const unsigned pos)
 
 #define set_pc_and_serialize(x) set_special_pc(x, PC_SERIALIZE_AFTER)
 
-#define yield() set_special_pc(npc, PC_YIELD)
+#define insn_yield() set_special_pc(npc, PC_YIELD)
 
 #define serialize() set_pc_and_serialize(npc)
 
diff --git a/riscv/insns/wfi.h b/riscv/insns/wfi.h
index d729f64..71312b6 100644
--- a/riscv/insns/wfi.h
+++ b/riscv/insns/wfi.h
@@ -9,4 +9,4 @@ if (get_field(STATE.mstatus->read(), MSTATUS_TW)) {
   require_privilege(PRV_S);
 }
 STATE.in_wfi = !STATE.debug_mode && !p->get_cfg().wfi_as_nop;
-yield();
+insn_yield();
