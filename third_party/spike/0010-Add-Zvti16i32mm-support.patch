 ZVT_CHECK_ALIGN_RS1;
 ZVT_CHECK_ALIGN_RS2;
 ZVT_CHECK_RS1_EMUL;
@@ -24,6 +24,33 @@
   
     P.VU.mt_elt<int32_t>(td, m, n) += dot_product<int32_t>(a.data(), b.data(), P.VU.tk);
   })
+} else if (P.VU.vsew == 16 && P.VU.widen == 2 && !P.VU.altfmt) {
+  require_extension(EXT_ZVTI16I32MM);
