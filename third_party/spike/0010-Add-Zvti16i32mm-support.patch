+  ZVT_MN_LOOP
+  ({
+    auto a = P.VU.mt_vector<uint16_t>(insn.rs2(), m);
+    auto b = P.VU.mt_vector<uint16_t>(insn.rs1(), n);
+    uint32_t sum = 0;
+    for (size_t ki = 0; ki < P.VU.tk; ki++) {
+      sum += static_cast<uint32_t>(a[ki]) * static_cast<uint32_t>(b[ki]);
+    }
+    P.VU.mt_elt<uint32_t>(td, m, n) += sum;
+  })
+} else if (P.VU.vsew == 16 && P.VU.widen == 2 && P.VU.altfmt) {
+  require_extension(EXT_ZVTI16I32MM);
+
+  ZVT_MN_LOOP
+  ({
+    auto a = P.VU.mt_vector<uint16_t>(insn.rs2(), m);
+    auto b = P.VU.mt_vector<int16_t>(insn.rs1(), n);
+    uint32_t sum = 0;
+    for (size_t ki = 0; ki < P.VU.tk; ki++) {
+      sum += static_cast<uint32_t>(a[ki]) *
+             static_cast<uint32_t>(static_cast<int32_t>(b[ki]));
+    }
+    P.VU.mt_elt<uint32_t>(td, m, n) += sum;
+  })
 } else {
   require(false);
 }
