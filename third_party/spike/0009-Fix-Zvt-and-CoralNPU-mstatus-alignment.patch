     set_vl(0, 1, 0, reg_t(-1));
 
   widen = vill ? 0 : twiden;
-  msettk(extract64(newMType, 5, 3));
-  msettm(extract64(newMType, 10, 14));
+  msettk(widen ? extract64(newMType, 5, 3) : 0);
+  msettm(widen ? extract64(newMType, 10, 14) : 0);
 }
 
 reg_t vectorUnit_t::read_mtype() const
 {
   return
-    widen |
+    (widen == 4 ? 3 : widen) |
     (tk << 5) |
     (tm << 10);
 }
