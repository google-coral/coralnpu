From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Hoang <hoangm@google.com>
Date: Fri, 16 Oct 2026 00:35:00 +0000
Subject: [PATCH 9/9] Fix Zvt and CoralNPU mstatus alignment

- Zero-initialize IEEEFloatFormat default constructor so partial-K dot
  products (tk < kmax) in vtfmm do not multiply uninitialized stack lanes.
- Initialize mstatus.FS and mstatus.VS to Initial (1) and legalize WARL
  writes of 0 (Off) to 3 (Dirty) to match CoralNPU hardware.
- Ensure vtfmm and vtfmm.alt always dirty mstatus.FS and mstatus.MS/VS
  even when tk == 0 or softfloat_exceptionFlags == 0, and mask fflags
  updates in vtfmm.tvv to only NV and OF per Zvt v0.4 section 12.1.1.8.
- Avoid dirtying mstatus.MS on read-only tile instructions (vtse*, vtmv.v.t)
  and honor vstart prestart elements in vtmv.v.t and vtmv.t.v per Zvt v0.4
  section 12.1.1.7.
- Fix vectorUnit_t::msetmtype to compute new_vlmul using the requested
  SEW from newVType and zero tk/tm when unconfigured or vill == 1.
- Fix vectorUnit_t::read_mtype to return mtwiden (3 when widen == 4) in
  mtype[1:0].
- Align vectorUnit_t::mt_elt 32-bit and 64-bit physical tile punning with
  CoralNPU VME RTL and MPACT.
---
diff --git a/riscv/bulknormdot.h b/riscv/bulknormdot.h
index a906f3e..9669b7e 100644
--- a/riscv/bulknormdot.h
+++ b/riscv/bulknormdot.h
@@ -66,7 +66,7 @@ template <typename U, typename M, typename E, unsigned expWidth, unsigned mantWi
 public:
   U n;
   IEEEFloatFormat(U _n) : n(_n) {}
-  IEEEFloatFormat() {}
+  IEEEFloatFormat() : n(0) {}
 
   int bias = (1 << (expWidth - 1)) - 1;
   int sigBits = mantWidth + 1;
diff --git a/riscv/csrs.cc b/riscv/csrs.cc
index 89cb6e4..d760c3e 100644
--- a/riscv/csrs.cc
+++ b/riscv/csrs.cc
@@ -717,6 +717,10 @@ bool mstatus_csr_t::unlogged_write(const reg_t val) noexcept {
   const reg_t requested_mpp = proc->legalize_privilege(get_field(val, MSTATUS_MPP));
   const reg_t adjusted_val = set_field(val, MSTATUS_MPP, requested_mpp);
   reg_t new_mstatus = (this->val & ~mask) | (adjusted_val & mask);
+  if (proc->extension_enabled('F') && (new_mstatus & MSTATUS_FS) == 0)
+    new_mstatus |= MSTATUS_FS;
+  if (proc->any_vector_extensions() && (new_mstatus & MSTATUS_VS) == 0)
+    new_mstatus |= MSTATUS_VS;
   new_mstatus = (new_mstatus & MSTATUS_MDT) ? (new_mstatus & ~MSTATUS_MIE) : new_mstatus;
   new_mstatus = (new_mstatus & MSTATUS_SDT) ? (new_mstatus & ~MSTATUS_SIE) : new_mstatus;
   maybe_flush_tlb(new_mstatus);
@@ -734,6 +738,8 @@ reg_t mstatus_csr_t::compute_mstatus_initial_value() const noexcept {
          | (proc->extension_enabled_const('S') && (proc->get_const_xlen() != 32) ? set_field((reg_t)0, MSTATUS_SXL, xlen_to_uxl(proc->get_const_xlen())) : 0)
          | (proc->get_mmu()->is_target_big_endian() ? big_endian_bits : 0)
          | (proc->extension_enabled(EXT_SMDBLTRP) ? MSTATUS_MDT : 0)
+         | (proc->extension_enabled('F') ? set_field((reg_t)0, MSTATUS_FS, 1) : 0)
+         | (proc->any_vector_extensions() ? set_field((reg_t)0, MSTATUS_VS, 1) : 0)
          | 0;  // initial value for mstatus
 }
 
