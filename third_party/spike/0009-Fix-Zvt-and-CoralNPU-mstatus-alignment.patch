diff --git a/riscv/vector_unit.cc b/riscv/vector_unit.cc
index bc50449..36f5dfc 100644
--- a/riscv/vector_unit.cc
+++ b/riscv/vector_unit.cc
@@ -24,7 +24,7 @@ void vectorUnit_t::vectorUnit_t::reset()
 
   mtype = std::make_shared<vector_csr_t>(p, CSR_MTYPE, 0);
   if (TE) {
-    mt.resize(16 * TE * TE);
+    mt.assign(16 * TE * TE, 0);
     state->add_csr(CSR_MTYPE, mtype);
   }
 
@@ -37,10 +37,15 @@ void vectorUnit_t::msetmtype(reg_t newMType, reg_t newVType)
   reg_t twiden = widen = (1 << extract64(newMType, 0, 2)) >> 1;
 
   if (twiden) {
+    reg_t req_vsew = 1 << (extract64(newVType, 3, 3) + 3);
+    reg_t req_kmax = std::max(reg_t(1), 32 / req_vsew);
+    reg_t req_tew = req_vsew * twiden;
+    reg_t req_ete = req_tew == 64 ? TE / 2 : TE;
+    reg_t req_eve = std::max(reg_t(1), VLEN / req_vsew);
     int new_vlmul = log2(
-      std::min(reg_t(8) / kmax(),
+      std::min(reg_t(8) / req_kmax,
       std::min(reg_t(8) / twiden,
-        std::max(reg_t(1), ete() / eve()))));
+        std::max(reg_t(1), req_ete / req_eve))));
     newVType = (newVType & ~reg_t(7)) | new_vlmul;
     newVType |= 0xc0; // vta=vma=1;
   }
@@ -50,15 +55,15 @@ void vectorUnit_t::msetmtype(reg_t newMType, reg_t newVType)
-  if (twiden * vsew > ELEN)
