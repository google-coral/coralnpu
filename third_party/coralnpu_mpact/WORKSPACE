# This WORKSPACE file is used as a template to override the default empty/generated
# WORKSPACE file inside the fetched @coralnpu_mpact external cache folder hermetically.
#
# By injecting this file dynamically via the 'workspace_file' parameter in
# rules/repos.bzl, we allow Bazel to fetch and compile `@coralnpu_mpact`'s own
# transitive dependencies standalone inside the cache folder, without polluting
# kelvin's repos.bzl.
#
# For more details on why this override exists and how we plan to remove it
# when transitioning to Bzlmod, see the README.md in this directory.

# Setup bazel repository.
workspace(name = "coralnpu_sim")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive", "http_file")

# Align bazel_skylib version to 1.9.0
http_archive(
    name = "bazel_skylib",
    sha256 = "3b5b49006181f5f8ff626ef8ddceaa95e9bb8ad294f7b5d7b11ea9f7ddaf8c59",
    urls = [
        "https://mirror.bazel.build/github.com/bazelbuild/bazel-skylib/releases/download/1.9.0/bazel-skylib-1.9.0.tar.gz",
        "https://github.com/bazelbuild/bazel-skylib/releases/download/1.9.0/bazel-skylib-1.9.0.tar.gz",
    ],
)

load("@bazel_skylib//:workspace.bzl", "bazel_skylib_workspace")

bazel_skylib_workspace()

# Define bazel_features
