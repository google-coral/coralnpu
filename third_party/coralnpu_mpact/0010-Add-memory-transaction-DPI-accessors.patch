+int mpact_get_num_mem_writes(uint32_t* num_writes) {
+  if (num_writes == nullptr || g_mpact_handle == nullptr ||
+      !g_mpact_handle->is_initialized()) {
+    return -1;
+  }
+  if (g_mpact_handle->tracing_memory() == nullptr) {
+    *num_writes = 0;
+    return 0;
+  }
+  *num_writes = static_cast<uint32_t>(
+      g_mpact_handle->tracing_memory()->writes().size());
+  return 0;
+}
+
+int mpact_get_mem_write(uint32_t index, uint32_t* addr, svLogicVecVal* wdata,
+                        uint32_t* wmask) {
+  if (addr == nullptr || wdata == nullptr || wmask == nullptr ||
+      g_mpact_handle == nullptr || !g_mpact_handle->is_initialized() ||
+      g_mpact_handle->tracing_memory() == nullptr) {
+    return -1;
+  }
+  const auto& writes = g_mpact_handle->tracing_memory()->writes();
+  if (index >= writes.size()) {
+    return -1;
+  }
+  const auto& t = writes[index];
+  *addr = t.addr;
+  *wmask = static_cast<uint32_t>(t.mask);
+  for (int i = 0; i < 4; ++i) {
+    wdata[i].aval = t.data[i];
+    wdata[i].bval = 0;
+  }
+  return 0;
+}
