 namespace {
 
+struct MpactMemTransaction {
+  uint32_t addr = 0;
+  uint32_t data[4] = {0, 0, 0, 0};
+  uint16_t mask = 0;
+};
+
+class TracingMemory : public ::mpact::sim::util::MemoryInterface {
+ public:
+  explicit TracingMemory(::mpact::sim::util::MemoryInterface* base)
+      : base_(base) {}
+
+  void Load(uint64_t address, ::mpact::sim::generic::DataBuffer* db,
+            ::mpact::sim::generic::Instruction* inst,
+            ::mpact::sim::generic::ReferenceCount* context) override {
+    base_->Load(address, db, inst, context);
+    if (enabled_) {
+      auto bytes = db->Get<uint8_t>();
+      for (size_t i = 0; i < bytes.size(); ++i) {
+        RecordByte(reads_, address + i, bytes[i]);
+      }
+    }
+  }
+
+  void Load(::mpact::sim::generic::DataBuffer* address_db,
+            ::mpact::sim::generic::DataBuffer* mask_db, int el_size,
+            ::mpact::sim::generic::DataBuffer* db,
+            ::mpact::sim::generic::Instruction* inst,
+            ::mpact::sim::generic::ReferenceCount* context) override {
+    base_->Load(address_db, mask_db, el_size, db, inst, context);
+    if (enabled_) {
+      auto addrs = address_db->Get<uint64_t>();
+      auto masks = mask_db->Get<bool>();
+      auto bytes = db->Get<uint8_t>();
+      for (size_t i = 0; i < masks.size(); ++i) {
+        if (masks[i]) {
+          uint64_t base_addr = addrs[i];
+          for (int b = 0; b < el_size; ++b) {
+            RecordByte(reads_, base_addr + b, bytes[i * el_size + b]);
+          }
+        }
+      }
+    }
+  }
+
+  void Store(uint64_t address,
+             ::mpact::sim::generic::DataBuffer* db) override {
+    if (enabled_) {
+      auto bytes = db->Get<uint8_t>();
+      for (size_t i = 0; i < bytes.size(); ++i) {
+        RecordByte(writes_, address + i, bytes[i]);
+      }
+    }
+    base_->Store(address, db);
+  }
+
+  void Store(::mpact::sim::generic::DataBuffer* address_db,
+             ::mpact::sim::generic::DataBuffer* mask_db, int el_size,
+             ::mpact::sim::generic::DataBuffer* db) override {
+    if (enabled_) {
+      auto addrs = address_db->Get<uint64_t>();
+      auto masks = mask_db->Get<bool>();
+      auto bytes = db->Get<uint8_t>();
+      for (size_t i = 0; i < masks.size(); ++i) {
+        if (masks[i]) {
+          uint64_t base_addr = addrs[i];
+          for (int b = 0; b < el_size; ++b) {
+            RecordByte(writes_, base_addr + b, bytes[i * el_size + b]);
+          }
+        }
+      }
+    }
+    base_->Store(address_db, mask_db, el_size, db);
+  }
+
+  void Clear() {
+    writes_.clear();
+    reads_.clear();
+  }
+
+  void Finalize() {
+    auto cmp = [](const MpactMemTransaction& a, const MpactMemTransaction& b) {
+      return a.addr < b.addr;
+    };
+    std::sort(writes_.begin(), writes_.end(), cmp);
+    std::sort(reads_.begin(), reads_.end(), cmp);
+  }
+
+  void set_enabled(bool enabled) { enabled_ = enabled; }
+  const std::vector<MpactMemTransaction>& writes() const { return writes_; }
+  const std::vector<MpactMemTransaction>& reads() const { return reads_; }
+
+ private:
+  static void RecordByte(std::vector<MpactMemTransaction>& vec,
+                         uint64_t byte_addr, uint8_t val) {
+    uint32_t row_addr = static_cast<uint32_t>(byte_addr & ~0xFULL);
+    uint32_t byte_off = static_cast<uint32_t>(byte_addr & 0xFULL);
+    uint32_t word_idx = byte_off >> 2;
+    uint32_t byte_in_word = (byte_off & 0x3U) * 8U;
+    MpactMemTransaction* t = nullptr;
+    for (auto& entry : vec) {
+      if (entry.addr == row_addr) {
+        t = &entry;
+        break;
+      }
+    }
+    if (!t) {
+      vec.push_back(MpactMemTransaction{row_addr, {0, 0, 0, 0}, 0});
+      t = &vec.back();
+    }
+    t->data[word_idx] &= ~(0xFFU << byte_in_word);
+    t->data[word_idx] |= (static_cast<uint32_t>(val) << byte_in_word);
+    t->mask |= static_cast<uint16_t>(1U << byte_off);
+  }
+
+  ::mpact::sim::util::MemoryInterface* base_ = nullptr;
+  bool enabled_ = false;
+  std::vector<MpactMemTransaction> writes_;
+  std::vector<MpactMemTransaction> reads_;
+};
