+TEST_F(CoralNPUM4ConfigTest, MtypeMasksReservedBitsAndValidatesAltfmt) {
+  // Non-zero reserved bits (31:24, 9:8, 4:2) in rs1 when mtwiden != 0
+  // set vtype.vill = 1 and mtype = 0 per Zvt v0.4 §12.1.1.4.
+  const uint32_t kReservedMtype =
+      0xFF00031Cu | 0x3u | (2u << 5) | (4u << 10);
+  SetXReg(1, kReservedMtype);
+  SetXReg(2, 1u << 8);
+  Execute(MakeVConfig(0b100'0010, /*rs2=*/2, /*rs1=*/1, 0b111, /*rd=*/0));
+  EXPECT_TRUE(rvv_->is_vill());
+  EXPECT_EQ(Mtype(), 0u);
+
+  // Valid mtype (mtwiden=3, tk=2, tm=4) with SEW=8 (vsew=0), altfmt=1 -> valid,
+  // and marks mstatus.vs Dirty.
+  state_->mstatus()->set_vs(::mpact::sim::riscv::RiscVMStatus::kStatusInitial);
+  state_->mstatus()->Submit();
+  SetXReg(1, 0x3u | (2u << 5) | (4u << 10));
+  SetXReg(2, 1u << 8);
+  Execute(MakeVConfig(0b100'0010, /*rs2=*/2, /*rs1=*/1, 0b111, /*rd=*/0));
+  EXPECT_FALSE(rvv_->is_vill());
+  EXPECT_EQ(Mtype(), 0x3u | (2u << 5) | (4u << 10));
+  EXPECT_EQ(state_->mstatus()->vs(),
+            ::mpact::sim::riscv::RiscVMStatus::kStatusDirty);
+
+  // Unconfigured (mtwiden=0) ignores upper rs1 bits, zeroes mtype, and
+  // preserves valid altfmt=1 (SEW=16) per v0.4.
+  SetXReg(1, 0xFF00031Cu);
+  SetXReg(2, (1u << 8) | (1u << 3));
+  Execute(MakeVConfig(0b100'0010, /*rs2=*/2, /*rs1=*/1, 0b111, /*rd=*/0));
+  EXPECT_FALSE(rvv_->is_vill());
+  EXPECT_EQ(rvv_->vtype() & (1u << 8), 1u << 8);
+  EXPECT_EQ(Mtype(), 0u);
+
+  // SEW=32 (vsew=2) with altfmt=1 is illegal -> sets vill=1 and mtype=0.
+  SetXReg(1, 0x1u | (1u << 5) | (4u << 10));
+  SetXReg(2, (1u << 8) | (2u << 3));
+  Execute(MakeVConfig(0b100'0010, /*rs2=*/2, /*rs1=*/1, 0b111, /*rd=*/0));
+  EXPECT_TRUE(rvv_->is_vill());
+  EXPECT_EQ(Mtype(), 0u);
+
+  // msettn when vill == 1 writes 0 to vl and rd, and clears vstart.
+  rvv_->set_vstart(5);
+  SetXReg(4, 8);
+  Execute(MakeVConfig(0b100'0100, /*rs2=*/0, /*rs1=*/4, 0b111, /*rd=*/3));
+  EXPECT_EQ(rvv_->vector_length(), 0u);
+  EXPECT_EQ(GetXReg(3), 0u);
+  EXPECT_EQ(rvv_->vstart(), 0u);
+
+  // When mstatus.vs == Off, msetmtype and msetmtypei trap with illegal inst.
+  bool trapped = false;
+  state_->set_on_trap(
+      [&trapped](bool, uint64_t, uint64_t, uint64_t,
+                 const ::mpact::sim::generic::Instruction*) -> bool {
+        trapped = true;
+        return true;
+      });
+  state_->mstatus()->set_vs(::mpact::sim::riscv::RiscVMStatus::kStatusOff);
+  state_->mstatus()->Submit();
+  Execute(MakeVConfig(0b100'0010, /*rs2=*/2, /*rs1=*/1, 0b111, /*rd=*/0));
+  EXPECT_TRUE(trapped);
+  trapped = false;
+  Execute(0x8841f057);
+  EXPECT_TRUE(trapped);
+}
