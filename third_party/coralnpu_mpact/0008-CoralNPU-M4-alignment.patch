+TEST_F(CoralNPUM4ConfigTest, MsetMtypeiDerivesVtypeAndLmul) {
+  // msetmtypei with uimm=3 (mtwiden=3), vsew=0 (SEW8) -> LMUL1 (vlmul=0).
+  Execute(0x8431f057);
+  EXPECT_EQ(rvv_->vector_length(), 0u);
+  EXPECT_EQ(matrix_->mtwiden(), 3);
+  EXPECT_EQ(rvv_->selected_element_width(), 1);  // 8-bit SEW
+  EXPECT_EQ(rvv_->vector_length_multiplier(), 8);  // LMUL 1 (8/8)
+
+  // msetmtypei with uimm=2 (mtwiden=2), vsew=1 (SEW16) -> LMUL2 (vlmul=1).
+  Execute(0x84b17057);
+  EXPECT_EQ(matrix_->mtwiden(), 2);
+  EXPECT_EQ(rvv_->selected_element_width(), 2);  // 16-bit SEW
+  EXPECT_EQ(rvv_->vector_length_multiplier(), 16);  // LMUL 2 (16/8)
+
+  // msetmtypei with uimm=1 (mtwiden=1), vsew=2 (SEW32) -> LMUL4 (vlmul=2).
+  Execute(0x8530f057);
+  EXPECT_EQ(matrix_->mtwiden(), 1);
+  EXPECT_EQ(rvv_->selected_element_width(), 4);  // 32-bit SEW
+  EXPECT_EQ(rvv_->vector_length_multiplier(), 32);  // LMUL 4 (32/8)
+
+  // msetmtypei with uimm=0 (mtwiden=0, unconfigured) -> mtype=0.
+  Execute(0x84307057);
+  EXPECT_EQ(matrix_->mtype(), 0u);
+  EXPECT_FALSE(matrix_->configured());
+}
+
 }  // namespace
