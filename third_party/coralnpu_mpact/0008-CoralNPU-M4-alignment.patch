+TEST_F(CoralNPUM4OpsTest, VstartPrestartUndisturbedAndMatmulTraps) {
+  Configure(/*mtype=*/0x3 | (2u << 5) | (2u << 10), /*vtype=*/0, /*tn=*/4);
+  for (int i = 0; i < 4; i++) {
+    matrix_->SetElem<uint8_t>(0, 0, i, 8, static_cast<uint8_t>(100 + i));
