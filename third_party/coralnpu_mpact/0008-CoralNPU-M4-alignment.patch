+  was_trap_handler_called_ = false;
+  Execute(MakeVMatrix(0b111'100, /*vs2=*/8, /*vs1=*/16, 0b000, /*mtd=*/3));
+  EXPECT_TRUE(was_trap_handler_called_);
+
+  // vs2 % 8 >= 8/KMAX (for SEW=8, KMAX=4, 8/KMAX=2 -> vs2=10 has 10%8=2) traps.
+  was_trap_handler_called_ = false;
+  Execute(MakeVMatrix(0b111'100, /*vs2=*/10, /*vs1=*/16, 0b000, /*mtd=*/1));
+  EXPECT_TRUE(was_trap_handler_called_);
+
+  // Executing vtfmm.tvv when configured for int8 (SEW=8, TWIDEN=4) traps.
+  was_trap_handler_called_ = false;
+  Execute(MakeVMatrix(0b111'100, /*vs2=*/8, /*vs1=*/16, 0b001, /*mtd=*/0));
+  EXPECT_TRUE(was_trap_handler_called_);
+}
