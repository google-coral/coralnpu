+  auto* mask_vec_op =
+      (mask_op != nullptr)
+          ? static_cast<::mpact::sim::riscv::RV32VectorSourceOperand*>(mask_op)
+          : nullptr;
+
+  int vd = (vd_reg_ptr && *vd_reg_ptr)
+               ? GetRegisterIndex(*vd_reg_ptr).value_or(-1)
+               : -1;
+  int vs2 = (vs2_vec_op && vs2_vec_op->GetRegister(0))
+                ? GetRegisterIndex(vs2_vec_op->GetRegister(0)).value_or(-1)
+                : -1;
+  bool masked =
+      (mask_vec_op != nullptr && mask_vec_op->GetRegister(0) != nullptr &&
+       mask_vec_op->GetRegister(0)->name() == "v0");
+
+  int vlmul = vector_state->vector_length_multiplier();
+  int lmul = std::max(1, vlmul / 8);
+  int emul = std::max(1, (vlmul * 2) / 8);
+  bool illegal_overlap = (vd < vs2 + emul && vs2 < vd + lmul) && (vd != vs2);
+
+  if (vlmul > 32 || vs2 % emul != 0 || vd % lmul != 0 || illegal_overlap ||
+      (masked && vd == 0)) {
+    vector_state->set_vector_exception();
+    return;
+  }
+
+  int vl = vector_state->vector_length();
+  int vstart = vector_state->vstart();
+  int vector_length_in_bytes = vector_state->vector_register_byte_length();
+  int elements_per_register = vector_length_in_bytes / sizeof(uint16_t);
+
+  absl::Span<const uint8_t> mask_span;
+  if (masked && mask_vec_op != nullptr && mask_vec_op->GetRegister(0)) {
+    mask_span = mask_vec_op->GetRegister(0)->data_buffer()->Get<uint8_t>();
+  }
+
+  bool has_nx = false;
+  bool has_uf = false;
+  bool has_of = false;
+  bool has_nv = false;
+
+  auto* host_fp = state->rv_fp()->host_fp_interface();
+  uint32_t old_fcsr = host_fp->GetRiscVFcsr();
+  host_fp->SetRiscVFcsr(old_fcsr & ~0x1F);
+
+  int num_vd_regs = std::min<int>(vd_op->size(), lmul);
+  {
+    ::mpact::sim::riscv::ScopedFPStatus scoped_fp(host_fp);
+
+    for (int reg_idx = 0; reg_idx < num_vd_regs; ++reg_idx) {
+      auto* vd_db = vd_op->CopyDataBuffer(reg_idx);
+      auto vd_span = vd_db->template Get<uint16_t>();
+
+      for (int i = 0; i < vd_span.size(); ++i) {
+        int element_idx = reg_idx * elements_per_register + i;
+        if (!IsElementActive(element_idx, vstart, vl, masked, mask_span)) {
+          continue;
+        }
+
+        uint32_t f32 = vs2_op->AsUint32(element_idx);
+        uint32_t fflags = 0;
+        uint16_t bf16 = ConvertF32ToBF16(f32, frm, state, &fflags);
+        if (fflags & kFcsrNX) has_nx = true;
+        if (fflags & kFcsrUF) has_uf = true;
+        if (fflags & kFcsrOF) has_of = true;
+        if (fflags & kFcsrNV) has_nv = true;
+
+        vd_span[i] = bf16;
+      }
+      vd_db->Submit(inst->Destination(0)->latency());
+    }
+  }
+
+  uint32_t new_fcsr = host_fp->GetRiscVFcsr();
+  uint32_t generated_flags = new_fcsr & 0x1F;
+  host_fp->SetRiscVFcsr(old_fcsr);
+
+  if (has_nx) generated_flags |= kFcsrNX;
+  if (has_uf) generated_flags |= kFcsrUF;
+  if (has_of) generated_flags |= kFcsrOF;
+  if (has_nv) generated_flags |= kFcsrNV;
+
+  auto* fflags_dest = inst->Destination(1);
+  if (fflags_dest != nullptr) {
+    auto* fflags_db = fflags_dest->AllocateDataBuffer();
+    fflags_db->Set<uint32_t>(0, generated_flags);
+    fflags_db->Submit(inst->Destination(1)->latency());
+  }
+
+  vector_state->clear_vstart();
+}
+
+void CoralNPUVfwmaccbf16vv(Instruction* inst) {
+  CoralNPUVfwmaccbf16(Vfwmaccbf16OperandType::kVector, inst);
+}
+
+void CoralNPUVfwmaccbf16vf(Instruction* inst) {
+  CoralNPUVfwmaccbf16(Vfwmaccbf16OperandType::kScalar, inst);
+}
