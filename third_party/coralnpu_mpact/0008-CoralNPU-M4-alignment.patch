+  EXPECT_EQ((matrix_->GetElem<uint8_t>(0, 0, 1, 8)), 101);
+  EXPECT_EQ((matrix_->GetElem<uint8_t>(0, 0, 2, 8)), 3);
+  EXPECT_EQ((matrix_->GetElem<uint8_t>(0, 0, 3, 8)), 4);
+
+  // vtmv.v.t with vstart=2 leaves prestart elements [0, 1] in v24 undisturbed.
+  SetVreg<uint8_t>(24, {55, 66, 77, 88});
+  rvv_->set_vstart(2);
+  Execute(MakeVArith(0b010'000, /*vs2=*/0b11111, /*vs1=*/3, 0b110, /*vd=*/24));
+  EXPECT_EQ(rvv_->vstart(), 0u);
+  auto [reg, unused] = state_->GetRegister<RVVectorRegister>("v24");
+  auto* v24 = reg->data_buffer();
+  EXPECT_EQ(v24->Get<uint8_t>(0), 55);
+  EXPECT_EQ(v24->Get<uint8_t>(1), 66);
+  EXPECT_EQ(v24->Get<uint8_t>(2), 3);
+  EXPECT_EQ(v24->Get<uint8_t>(3), 4);
+
+  // Non-zero vstart on matmul traps.
+  was_trap_handler_called_ = false;
+  rvv_->set_vstart(1);
+  Execute(MakeVMatrix(0b111'100, /*vs2=*/8, /*vs1=*/16, 0b000, /*mtd=*/1));
+  EXPECT_TRUE(was_trap_handler_called_);
