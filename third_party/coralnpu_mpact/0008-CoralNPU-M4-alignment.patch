+void CoralNPUFcvtSBf16(Instruction* inst) {
+  auto state = static_cast<::mpact::sim::riscv::RiscVState*>(inst->state());
+  if (state->mstatus()->fs() == 0) {
+    state->Trap(/*is_interrupt=*/false, /*trap_value=*/0,
+                *mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                /*epc=*/inst->address(), inst);
+    return;
+  }
+  uint32_t rm_val = inst->Source(1)->AsUint32(0);
+  FPRoundingMode rm = static_cast<FPRoundingMode>(rm_val);
+  switch (rm) {
+    case FPRoundingMode::kRoundToNearest:
+    case FPRoundingMode::kRoundTowardsZero:
+    case FPRoundingMode::kRoundDown:
+    case FPRoundingMode::kRoundUp:
+    case FPRoundingMode::kRoundToNearestTiesToMax:
+      break;
+    case FPRoundingMode::kDynamic:
+      if (!state->rv_fp()->rounding_mode_valid()) {
+        state->Trap(/*is_interrupt=*/false, /*trap_value=*/0,
+                    *mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                    /*epc=*/inst->address(), inst);
+        return;
+      }
+      break;
+    default:
+      state->Trap(/*is_interrupt=*/false, /*trap_value=*/0,
+                  *mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                  /*epc=*/inst->address(), inst);
+      return;
+  }
+
+  auto* rs1_op = inst->Source(0);
+  uint64_t f64 = rs1_op->AsUint64(0);
+  uint32_t f32 = 0;
+  if ((f64 & 0xFFFFFFFFFFFF0000ULL) == 0xFFFFFFFFFFFF0000ULL) {
+    uint16_t bf16 = f64 & 0xFFFF;
+    f32 = bf16 << 16;
+    if (BF16Info::IsNaN(bf16)) {
+      f32 = FPTypeInfo<float>::kCanonicalNaN;
+      if (BF16Info::IsSNaN(bf16)) {
+        auto* fflags_db = inst->Destination(1)->AllocateDataBuffer();
+        fflags_db->Set<uint32_t>(0, *FPExceptions::kInvalidOp);
+        fflags_db->Submit();
+      }
+    }
+  } else {
+    f32 = FPTypeInfo<float>::kCanonicalNaN;
+  }
+
+  auto* rd_op =
+      static_cast<RegisterDestinationOperand<uint64_t>*>(inst->Destination(0));
+  auto* rd_reg = rd_op->GetRegister();
+  rd_reg->data_buffer()->Set<uint64_t>(
+      0, static_cast<uint64_t>(f32) | (~uint64_t{0} << 32));
+}
