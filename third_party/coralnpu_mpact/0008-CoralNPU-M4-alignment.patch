+  SetXReg(3, MakeTss(/*tile=*/0, /*pattern=*/0, /*index=*/0));
+
+  // vtmv.t.v with vstart=2 updates only elements [2, 3] and resets vstart=0.
+  rvv_->set_vstart(2);
+  Execute(MakeVArith(0b010'111, /*vs2=*/8, /*vs1=*/3, 0b110, /*vd=*/0));
+  EXPECT_EQ(rvv_->vstart(), 0u);
