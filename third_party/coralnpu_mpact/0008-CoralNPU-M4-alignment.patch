+constexpr uint32_t kFcsrNV = 0x10;
+constexpr uint32_t kFcsrOF = 0x04;
+constexpr uint32_t kFcsrUF = 0x02;
+constexpr uint32_t kFcsrNX = 0x01;
+
+constexpr uint32_t kF32CanonicalQuietNaN = 0x7FC00000;
+constexpr uint32_t kF32ExponentFractionMask = 0x7FFFFFFF;
+constexpr uint32_t kF32Infinity = 0x7F800000;
+constexpr uint32_t kF32SignalingBit = 0x00400000;
+
+constexpr uint16_t kBf16CanonicalQuietNaN = 0x7FC0;
+constexpr uint16_t kBf16AbsMask = 0x7FFF;
+constexpr uint16_t kBf16Infinity = 0x7F80;
+
+struct Bf16ToF32Result {
+  uint32_t bits;
+  bool has_nv;
+};
+
+Bf16ToF32Result ConvertBf16ToF32Bits(uint16_t bf16) {
+  Bf16ToF32Result result = {static_cast<uint32_t>(bf16) << 16, false};
+  if ((bf16 & kBf16AbsMask) > kBf16Infinity) {
+    result.bits = kF32CanonicalQuietNaN;
+    if (BF16Info::IsSNaN(bf16)) {
+      result.has_nv = true;
+    }
+  }
+  return result;
+}
+
+struct ScopedHostRoundNearest {
+  int saved_round;
+  ScopedHostRoundNearest() : saved_round(std::fegetround()) {
+    if (saved_round != FE_TONEAREST) {
+      std::fesetround(FE_TONEAREST);
+    }
+  }
+  ~ScopedHostRoundNearest() {
+    if (saved_round != FE_TONEAREST) {
+      std::fesetround(saved_round);
+    }
+  }
+};
+
+struct RoundingResult {
+  float value;
+  bool has_nx;
+};
+
+RoundingResult RoundToNearestMaxMagnitude(double exact_res) {
+  ScopedHostRoundNearest round_guard;
+  if (std::isnan(exact_res)) {
+    return {absl::bit_cast<float>(kF32CanonicalQuietNaN), false};
+  }
+  RoundingResult res = {0.0f, false};
+  float f_rne = static_cast<float>(exact_res);
+  if (static_cast<double>(f_rne) != exact_res) {
+    res.has_nx = true;
+  }
+  float rdn;
+  float rup;
+  if (static_cast<double>(f_rne) == exact_res) {
+    rdn = f_rne;
+    rup = f_rne;
+  } else {
+    float other;
+    if (static_cast<double>(f_rne) < exact_res) {
+      other = std::nextafterf(f_rne, std::numeric_limits<float>::infinity());
+    } else {
+      other = std::nextafterf(f_rne, -std::numeric_limits<float>::infinity());
+    }
+    rdn = std::min(f_rne, other);
+    rup = std::max(f_rne, other);
+  }
+  if (rdn == rup) {
+    res.value = rdn;
+    return res;
+  }
+  res.has_nx = true;
+  double d_rdn = exact_res - static_cast<double>(rdn);
+  double d_rup = static_cast<double>(rup) - exact_res;
+  if (d_rdn < d_rup) {
+    res.value = rdn;
+  } else if (d_rdn > d_rup) {
+    res.value = rup;
+  } else {
+    res.value = (exact_res >= 0.0) ? rup : rdn;
+  }
+  return res;
+}
+
+uint32_t GetInstructionWord(::mpact::sim::riscv::RiscVState* state,
+                            const Instruction* inst) {
+  uint64_t address = inst->address();
+  auto* db = state->db_factory()->Allocate<uint32_t>(1);
+  state->LoadMemory(inst, address, db, nullptr, nullptr);
+  uint32_t inst_word = db->Get<uint32_t>(0);
+  db->DecRef();
+  if ((inst_word & 0b11) != 0b11) inst_word &= 0xffff;
+  return inst_word;
+}
+
+std::optional<int> GetRegisterIndex(
+    const ::mpact::sim::generic::RegisterBase* reg) {
+  if (reg == nullptr) return std::nullopt;
+  std::string_view name = reg->name();
+  if (name.empty() || (name[0] != 'v' && name[0] != 'f' && name[0] != 'x')) {
+    return std::nullopt;
+  }
+  int index = 0;
+  if (!absl::SimpleAtoi(name.substr(1), &index)) {
+    return std::nullopt;
+  }
+  return index;
+}
+
+bool IsElementActive(int element_idx, int vstart, int vl, bool masked,
+                     absl::Span<const uint8_t> mask_span) {
+  if (element_idx < vstart || element_idx >= vl) return false;
+  if (!masked || mask_span.empty()) return true;
+  int byte_idx = element_idx / 8;
+  int bit_idx = element_idx % 8;
+  return (mask_span[byte_idx] & (1 << bit_idx)) != 0;
+}
+
+enum class Vfwmaccbf16OperandType {
+  kVector,
+  kScalar,
+};
+
+void CoralNPUVfwmaccbf16(Vfwmaccbf16OperandType operand_type,
+                         Instruction* inst) {
+  auto* state = static_cast<::mpact::sim::riscv::RiscVState*>(inst->state());
+  if (state->mstatus()->fs() == 0) {
+    state->rv_vector()->set_vector_exception();
+    state->Trap(/*is_interrupt=*/false,
+                /*trap_value=*/GetInstructionWord(state, inst),
+                *::mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                /*epc=*/inst->address(), inst);
+    return;
+  }
+  auto* vector_state = state->rv_vector();
+  if (vector_state->is_vill()) {
+    vector_state->set_vector_exception();
+    state->Trap(/*is_interrupt=*/false,
+                /*trap_value=*/GetInstructionWord(state, inst),
+                *::mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                /*epc=*/inst->address(), inst);
+    return;
+  }
+
+  uint32_t frm_check = static_cast<uint32_t>(state->rv_fp()->GetRoundingMode());
+  if (frm_check == 5 || frm_check == 6 || frm_check > 7) {
+    state->rv_vector()->set_vector_exception();
+    state->Trap(/*is_interrupt=*/false,
+                /*trap_value=*/GetInstructionWord(state, inst),
+                *::mpact::sim::riscv::ExceptionCode::kIllegalInstruction,
+                inst->address(), inst);
+    return;
+  }
+  uint32_t vtype = vector_state->vtype();
+  int vsew = (vtype >> 3) & 0x7;
+  if (!state->rv_fp()->rounding_mode_valid() || vsew != 1) {
+    vector_state->set_vector_exception();
+    return;
+  }
+  uint32_t frm = static_cast<uint32_t>(state->rv_fp()->GetRoundingMode());
+
+  auto* vd_op = static_cast<::mpact::sim::riscv::RV32VectorDestinationOperand*>(
+      inst->Destination(0));
+  auto vd_obj = vd_op->GetObject(0);
+  auto* vd_reg_ptr =
+      std::any_cast<::mpact::sim::generic::RegisterBase*>(&vd_obj);
+
+  auto* vs2_op =
+      static_cast<::mpact::sim::riscv::RV32VectorSourceOperand*>(inst->Source(0));
+  auto* vs2_reg_ptr = vs2_op->GetRegister(0);
+
+  if (!vd_reg_ptr || !vs2_reg_ptr) {
+    vector_state->set_vector_exception();
+    return;
+  }
+
+  int vd = GetRegisterIndex(*vd_reg_ptr).value_or(-1);
+  int vs2 = GetRegisterIndex(vs2_reg_ptr).value_or(-1);
+  int vs1 = -1;
+  if (operand_type == Vfwmaccbf16OperandType::kVector) {
+    auto* vs1_vec_op =
+        static_cast<::mpact::sim::riscv::RV32VectorSourceOperand*>(
+            inst->Source(1));
+    if (!vs1_vec_op) {
+      vector_state->set_vector_exception();
+      return;
+    }
+    auto* vs1_reg_ptr = vs1_vec_op->GetRegister(0);
+    if (!vs1_reg_ptr) {
+      vector_state->set_vector_exception();
+      return;
+    }
+    vs1 = GetRegisterIndex(vs1_reg_ptr).value_or(-1);
+  }
+
+  auto* mask_vec_op =
+      (inst->SourcesSize() > 3 && inst->Source(3) != nullptr)
+          ? static_cast<::mpact::sim::riscv::RV32VectorSourceOperand*>(
+                inst->Source(3))
+          : nullptr;
+  bool masked =
+      (mask_vec_op != nullptr && mask_vec_op->GetRegister(0) != nullptr &&
+       mask_vec_op->GetRegister(0)->name() == "v0");
+
+  int vlmul = vector_state->vector_length_multiplier();
+  int lmul = std::max(1, vlmul / 8);
+  int emul = std::max(1, (vlmul * 2) / 8);
+
+  bool illegal_overlap_vs1 =
+      (vd < vs1 + lmul && vs1 < vd + emul) && (vs1 != vd + lmul);
+  bool illegal_overlap_vs2 =
+      (vd < vs2 + lmul && vs2 < vd + emul) && (vs2 != vd + lmul);
+
+  bool vs1_illegal = (operand_type == Vfwmaccbf16OperandType::kVector) &&
+                     (vs1 % lmul != 0 || illegal_overlap_vs1);
+
+  if (vlmul > 32 || vd % emul != 0 || vs1_illegal || vs2 % lmul != 0 ||
+      illegal_overlap_vs2 || (masked && vd == 0)) {
+    vector_state->set_vector_exception();
+    return;
+  }
+
+  auto* vs1_op = inst->Source(1);
+  auto* vd_src_op = inst->Source(2);
+
+  absl::Span<const uint8_t> mask_span;
+  if (masked && mask_vec_op != nullptr && mask_vec_op->GetRegister(0)) {
+    mask_span = mask_vec_op->GetRegister(0)->data_buffer()->Get<uint8_t>();
+  }
+
+  int vl = vector_state->vector_length();
+  int vstart = vector_state->vstart();
+
+  bool has_nv = false;
+  bool has_nx = false;
+  auto* host_fp = state->rv_fp()->host_fp_interface();
+  uint32_t old_fcsr = host_fp->GetRiscVFcsr();
+  host_fp->SetRiscVFcsr(old_fcsr & ~0x1F);
+
+  int num_vd_regs = std::min<int>(vd_op->size(), emul);
+  {
+    ::mpact::sim::riscv::ScopedFPStatus scoped_fp(host_fp);
+    ::mpact::sim::riscv::ScopedFPRoundingMode scoped_rm(host_fp, frm);
+
+    for (int reg_idx = 0; reg_idx < num_vd_regs; ++reg_idx) {
+      auto* vd_db = vd_op->AllocateDataBuffer(reg_idx);
+      auto vd_span = vd_db->template Get<uint32_t>();
+      for (int i = 0; i < vd_span.size(); ++i) {
+        int idx = reg_idx * vd_span.size() + i;
+        bool mask_val = true;
+        if (masked && !mask_span.empty()) {
+          mask_val = (mask_span[idx >> 3] & (1 << (idx & 7))) != 0;
+        }
+        bool active = (idx >= vstart && idx < vl) && mask_val;
+        uint32_t vd_val = vd_src_op->AsUint32(idx);
+        if (!active) {
+          vd_span[i] = vd_val;
+          continue;
+        }
+        uint16_t vs2_val = vs2_op->AsUint16(idx);
+        uint16_t vs1_val = 0;
+        if (operand_type == Vfwmaccbf16OperandType::kScalar) {
+          uint64_t f64 = vs1_op->AsUint64(0);
+          if ((f64 & kBoxedBf16Mask) != kBoxedBf16Mask) {
+            vs1_val = kBf16CanonicalQuietNaN;
+          } else {
+            vs1_val = static_cast<uint16_t>(f64);
+          }
+        } else {
+          vs1_val = vs1_op->AsUint16(idx);
+        }
+
+        Bf16ToF32Result vs1_conv = ConvertBf16ToF32Bits(vs1_val);
+        Bf16ToF32Result vs2_conv = ConvertBf16ToF32Bits(vs2_val);
+        uint32_t vs1_w = vs1_conv.bits;
+        uint32_t vs2_w = vs2_conv.bits;
+        if (vs1_conv.has_nv || vs2_conv.has_nv) has_nv = true;
+
+        bool vd_is_nan = (vd_val & kF32ExponentFractionMask) > kF32Infinity;
+        bool vd_is_snan = vd_is_nan && ((vd_val & kF32SignalingBit) == 0);
+        if (vd_is_snan) has_nv = true;
+
+        if (FPTypeInfo<float>::IsNaN(absl::bit_cast<float>(vs1_w)) ||
+            FPTypeInfo<float>::IsNaN(absl::bit_cast<float>(vs2_w)) ||
+            vd_is_nan) {
+          vd_span[i] = kF32CanonicalQuietNaN;
+          continue;
+        }
+
+        float vd_f;
+        float vs1_f;
+        float vs2_f;
+        std::memcpy(&vd_f, &vd_val, sizeof(float));
+        std::memcpy(&vs1_f, &vs1_w, sizeof(float));
+        std::memcpy(&vs2_f, &vs2_w, sizeof(float));
+
+        float res;
+        double exact_res =
+            static_cast<double>(vd_f) +
+            static_cast<double>(vs1_f) * static_cast<double>(vs2_f);
+        if (frm == 4) {
+          auto rounding_res = RoundToNearestMaxMagnitude(exact_res);
+          res = rounding_res.value;
+          if (rounding_res.has_nx) has_nx = true;
+        } else {
+          res = std::fma(vs1_f, vs2_f, vd_f);
+          if (static_cast<double>(res) != exact_res) {
+            has_nx = true;
+          }
+        }
+
+        uint32_t res_val;
+        std::memcpy(&res_val, &res, sizeof(float));
+        vd_span[i] = res_val;
+      }
+      vd_db->Submit(inst->Destination(0)->latency());
+    }
+  }
+
+  uint32_t new_fcsr = host_fp->GetRiscVFcsr();
+  uint32_t generated_flags = new_fcsr & 0x1F;
+  host_fp->SetRiscVFcsr(old_fcsr);
+
+  if (has_nv) generated_flags |= kFcsrNV;
+  if (has_nx) generated_flags |= kFcsrNX;
+
+  auto* fflags_dest = inst->Destination(1);
+  if (fflags_dest != nullptr) {
+    auto* fflags_db = fflags_dest->AllocateDataBuffer();
+    fflags_db->Set<uint32_t>(0, generated_flags);
+    fflags_db->Submit(inst->Destination(1)->latency());
+  }
+
+  vector_state->clear_vstart();
+}
