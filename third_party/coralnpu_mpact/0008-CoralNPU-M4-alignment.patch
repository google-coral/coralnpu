+               ? GetRegisterIndex(*vd_reg_ptr).value_or(-1)
+               : -1;
+  int vs2 = (vs2_vec_op && vs2_vec_op->GetRegister(0))
+                ? GetRegisterIndex(vs2_vec_op->GetRegister(0)).value_or(-1)
+                : -1;
