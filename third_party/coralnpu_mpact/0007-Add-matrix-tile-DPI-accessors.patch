+namespace {
+int NumTilesForTewHelper(uint32_t tew) {
+  switch (tew) {
+    case 8:  return 16;
+    case 16: return 8;
+    case 32: return 4;
+    case 64: return 8;
+    default: return 0;
+  }
+}
+
+int EteForTewHelper(int tile_elements, uint32_t tew) {
+  return tew == 64 ? tile_elements / 2 : tile_elements;
+}
+
+int CanonicalTileForTewHelper(int tile, uint32_t tew) {
+  const int num_tiles = NumTilesForTewHelper(tew);
+  if (num_tiles == 0) return tile;
+  const int stride = 16 / num_tiles;
+  return tile & ~(stride - 1);
+}
+}  // namespace
+
+absl::StatusOr<std::vector<uint8_t>> CoralNPUSimulator::ReadMatrixTile(
+    uint32_t tile, uint32_t tew) const {
+  if (matrix_state_ == nullptr) {
+    return absl::FailedPreconditionError(
+        "Matrix tile state is not present for this architecture");
+  }
+  if (tile >= 16) {
+    return absl::InvalidArgumentError("Matrix tile index must be below 16");
+  }
+  if (NumTilesForTewHelper(tew) == 0) {
+    return absl::InvalidArgumentError("Matrix TEW must be 8, 16, 32, or 64");
+  }
+
+  const int canonical_tile = CanonicalTileForTewHelper(static_cast<int>(tile), tew);
+  const int ete = EteForTewHelper(matrix_state_->tile_elements(), tew);
+  const int element_bytes = static_cast<int>(tew / 8);
+  std::vector<uint8_t> result(ete * ete * element_bytes);
+  for (int row = 0; row < ete; ++row) {
+    for (int col = 0; col < ete; ++col) {
+      const int offset = (row * ete + col) * element_bytes;
+      switch (tew) {
+        case 8: {
+          const uint8_t value = matrix_state_->GetElem<uint8_t>(
+              canonical_tile, row, col, tew);
+          std::memcpy(&result[offset], &value, sizeof(value));
+          break;
+        }
+        case 16: {
+          const uint16_t value = matrix_state_->GetElem<uint16_t>(
+              canonical_tile, row, col, tew);
+          std::memcpy(&result[offset], &value, sizeof(value));
+          break;
+        }
+        case 32: {
+          const uint32_t value = matrix_state_->GetElem<uint32_t>(
+              canonical_tile, row, col, tew);
+          std::memcpy(&result[offset], &value, sizeof(value));
+          break;
+        }
+        case 64: {
+          const uint64_t value = matrix_state_->GetElem<uint64_t>(
+              canonical_tile, row, col, tew);
+          std::memcpy(&result[offset], &value, sizeof(value));
+          break;
+        }
+      }
+    }
+  }
+  return result;
+}
