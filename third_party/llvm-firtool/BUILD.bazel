package(default_visibility = ["//visibility:public"])

exports_files(glob(["org.chipsalliance/**"]))

# Local firtool installation in tools/firtool/
sh_binary(
    name = "firtool",
    srcs = [":firtool.sh"],
    data = select({
        "@platforms//os:macos": ["@llvm_firtool//:org.chipsalliance/llvm-firtool/macos-x64/bin/firtool"],
        "//conditions:default": ["@llvm_firtool//:org.chipsalliance/llvm-firtool/linux-x64/bin/firtool"],
    }),
)
