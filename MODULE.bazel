    "coralnpu_pip_deps_importlib_resources",
    "coralnpu_pip_deps_iniconfig",
    "coralnpu_pip_deps_intelhex",
    "coralnpu_pip_deps_intervaltree",
    "coralnpu_pip_deps_jinja2",
    "coralnpu_pip_deps_lark",
    "coralnpu_pip_deps_libusb_package",
    "coralnpu_pip_deps_mako",
    "coralnpu_pip_deps_markupsafe",
    "coralnpu_pip_deps_ml_dtypes",
    "coralnpu_pip_deps_natsort",
    "coralnpu_pip_deps_numpy",
    "coralnpu_pip_deps_okonomiyaki",
    "coralnpu_pip_deps_packaging",
    "coralnpu_pip_deps_pillow",
    "coralnpu_pip_deps_pluggy",
    "coralnpu_pip_deps_prettytable",
    "coralnpu_pip_deps_psutil",
    "coralnpu_pip_deps_pyelftools",
    "coralnpu_pip_deps_pyftdi",
    "coralnpu_pip_deps_pylink_square",
    "coralnpu_pip_deps_pyocd",
    "coralnpu_pip_deps_pyparsing",
    "coralnpu_pip_deps_pyserial",
    "coralnpu_pip_deps_pytest",
    "coralnpu_pip_deps_pyusb",
    "coralnpu_pip_deps_pyyaml",
    "coralnpu_pip_deps_simplesat",
    "coralnpu_pip_deps_six",
    "coralnpu_pip_deps_sortedcontainers",
    "coralnpu_pip_deps_tqdm",
    "coralnpu_pip_deps_typing_extensions",
    "cvfpu",
    "flatbuffers",
    "fpu_div_sqrt_mvp",
    "freertos",
    "gemmlowp",
    "hedron_compile_commands",
    "internal_check",
    "ispyocto",
    "kissfft",
    "libsystemctlm_soc",
    "llvm_firtool",
    "lowrisc_opentitan_gh",
    "net_zlib",
    "nonhermetic",
    "org_antlr4_cpp_runtime",
